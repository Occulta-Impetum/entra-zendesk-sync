# Secrets and machine-specific authentication values.
# Never commit a populated .env file.

# Microsoft Entra / Microsoft Graph
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Certificate-based authentication will be preferred for production.
ENTRA_CERT_THUMBPRINT=
ENTRA_CERT_PATH=
ENTRA_CERT_PRIVATE_KEY_PATH=

# Zendesk OAuth
ZENDESK_SUBDOMAIN=
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=
