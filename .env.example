# Secrets and machine-specific authentication values.
# Never commit a populated .env file.

# Microsoft Entra / Microsoft Graph
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Path to the password-protected PFX containing the client certificate and private key.
# Example: C:\SysadminBot\EntraZendeskSync\certificates\entra-zendesk-sync.pfx
ENTRA_CERTIFICATE_PATH=
# Password protecting the PFX file. Keep this secret and restrict access to .env.
ENTRA_CERTIFICATE_PASSWORD=

# Zendesk OAuth
ZENDESK_SUBDOMAIN=
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=
